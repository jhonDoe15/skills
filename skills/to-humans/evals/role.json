{
  "skill_name": "to-humans",
  "version": 1,
  "evaluation": {
    "scope": "to-humans-role",
    "layer": "role",
    "skill": "to-humans",
    "hosts": ["claude-code", "cursor"],
    "arms": ["no-skill", "treatment"]
  },
  "config": {
    "runs_per_configuration": 3,
    "minimum_treatment_pass_rate": 0.9,
    "minimum_treatment_win_rate": 0.6,
    "randomization_seed": "to-humans-role-v1"
  },
  "judge": {
    "score_range": [0, 2],
    "minimum_dimension_score": 1,
    "dimensions": [
      {
        "id": "coverage",
        "description": "Preserves every requested item, material fact, uncertainty, and limit."
      },
      {
        "id": "reader_fit",
        "description": "Calibrates vocabulary, depth, organization, and tone to the stated reader."
      },
      {
        "id": "actionability",
        "description": "Leads with the answer and groups material by what the reader needs to do."
      },
      {
        "id": "voice",
        "description": "Removes filler and artificial patterns without flattening contextual voice."
      }
    ]
  },
  "evals": [
    {
      "id": "human-status",
      "name": "human project status with complete actions",
      "prompt": "Write a status reply for an experienced release lead. Rollback is verified, but peak demand remains untested. Recommend whether to start a staged rollout today. Preserve these separate requested actions: at 14:00 the release lead stages the internal cohort; before rollout the support owner prepares the customer notice; before approval the security owner verifies that the exception expires Friday.",
      "expected_output": "The answer appears first, all three requested owner actions remain visible, the basis follows, and the prose is direct and easy to scan.",
      "files": [],
      "expectations": [
        "The first paragraph states the recommendation.",
        "Release, support, and security actions all remain present.",
        "The action list identifies concrete accountable owners.",
        "Vocabulary and depth fit an experienced release lead.",
        "The prose contains no em dash."
      ],
      "covers": [
        "answer-first",
        "requested-breadth",
        "reader-calibration",
        "scan-structure",
        "action-grouping",
        "plain-wording",
        "concrete-attribution",
        "no-em-dash"
      ],
      "deterministic": {
        "required_terms": [
          {"name": "requested item release", "term": "release"},
          {"name": "requested item support", "term": "support"},
          {"name": "requested item security", "term": "security"}
        ],
        "answer_first": {
          "topic_patterns": [
            "\\b(?:staged|limited|canary) rollout\\b"
          ],
          "answer_patterns": [
            "\\b(?:start|proceed|approve|use|choose|delay|hold|pause|safer|safest)\\b"
          ]
        },
        "accountable_actions": [
          {
            "name": "release",
            "owner_patterns": [
              "\\brelease(?: engineering| lead| owner)?\\b"
            ],
            "action_patterns": [
              "\\b(?:starts|will start|stages|will stage|deploys|will deploy|rolls out|will roll out)\\b"
            ],
            "source_patterns": [
              "\\b(?:internal (?:group|cohort)|first cohort)\\b"
            ],
            "qualifier_patterns": [
              "\\b(?:14:00|2\\s*(?:p\\.?m\\.?|pm)|two in the afternoon)\\b"
            ],
            "predicate_object_patterns": [
              "\\b(?:starts|stages|deploys|rolls out|will (?:start|stage|deploy|roll out)|must (?:start|stage|deploy|roll out)) (?:with )?(?:the )?(?:internal (?:group|cohort)|first cohort)\\b"
            ]
          },
          {
            "name": "support",
            "owner_patterns": [
              "\\b(?:customer )?support(?: team| lead| owner)?\\b"
            ],
            "action_patterns": [
              "\\b(?:prepares|will prepare|publishes|will publish|notifies|will notify)\\b"
            ],
            "source_patterns": [
              "\\b(?:customer notice|customer message|support notice)\\b"
            ],
            "qualifier_patterns": [
              "\\b(?:before|prior to|ahead of) (?:the )?(?:staged )?rollout\\b"
            ],
            "predicate_object_patterns": [
              "\\b(?:prepares|publishes|notifies|will (?:prepare|publish|notify)|must (?:prepare|publish|notify)) (?:the )?(?:customer notice|customer message|support notice)\\b"
            ]
          },
          {
            "name": "security",
            "owner_patterns": [
              "\\bsecurity(?: team| lead| owner)?\\b"
            ],
            "action_patterns": [
              "\\b(?:verifies|will verify|reviews|will review|confirms|will confirm)\\b"
            ],
            "source_patterns": [
              "\\b(?:exception (?:expires|expiry)|exception's expiry|exception expiration)\\b"
            ],
            "qualifier_patterns": [
              "\\b(?:Friday|before approval|prior to approval)\\b"
            ],
            "predicate_object_patterns": [
              "\\b(?:verifies|reviews|confirms|will (?:verify|review|confirm)|must (?:verify|review|confirm))(?: before approval| prior to approval)? (?:that )?(?:the )?(?:exception (?:expires|expiry)|exception's expiry|exception expiration)\\b"
            ]
          }
        ],
        "forbidden_patterns": [],
        "no_em_dash": true
      }
    },
    {
      "id": "decision-support",
      "name": "decision support with bounded recommendation",
      "prompt": "Recommend one of two deployment options to an engineering manager. A limited release has a verified rollback. It starts with a small first cohort, which contains exposure; a full deployment reaches everyone at once. Peak traffic remains untested. The noon load test passes when p95 latency stays under 200 ms; a passing result supports moving to full deployment, while a miss means keeping the limited release. Include the basis, material uncertainty, and the evidence that would change the recommendation.",
      "expected_output": "The response states one recommendation, its basis, material uncertainty, and a concrete condition that would change it.",
      "files": [],
      "expectations": [
        "The recommendation is explicit.",
        "The basis names concrete evidence.",
        "Material uncertainty is visible.",
        "The response says what could change the recommendation."
      ],
      "covers": ["decision-support", "answer-first", "concrete-attribution"],
      "deterministic": {
        "answer_first": {
          "topic_patterns": [
            "\\b(?:limited|staged|full) (?:release|rollout|deployment)\\b"
          ],
          "answer_patterns": [
            "\\b(?:recommend|choose|prefer|use|start|proceed|safer|safest|hold|delay)\\b"
          ]
        },
        "decision_support": {
          "recommendation": {
            "claim_patterns": [
              "\\b(?:recommend|choose|prefer|use|start|proceed with) (?:a |the )?(?:limited|staged) (?:release|rollout|deployment)\\b",
              "\\b(?:limited|staged) (?:release|rollout|deployment) (?:is|looks|remains) (?:safer|safest|best|preferred|recommended)\\b"
            ]
          },
          "basis": {
            "all_of": [
              {
                "claim_patterns": [
                  "\\bverified rollback\\b",
                  "\\brollback (?:is|was|has been) verified\\b"
                ]
              },
              {
                "claim_patterns": [
                  "\\b(?:small|limited) first cohort (?:contains|caps|limits|reduces) (?:the )?(?:exposure|risk|blast radius)\\b",
                  "\\b(?:exposure|risk|blast radius) (?:is |stays )?(?:contained|capped|limited|reduced) (?:by|with|through) (?:the )?(?:small|limited) first cohort\\b"
                ]
              }
            ]
          },
          "material_uncertainty": {
            "allow_negation": true,
            "claim_patterns": [
              "\\bpeak (?:traffic|demand|load) (?:remains|is) untested\\b",
              "\\b(?:have|has) not (?:yet )?(?:tested|exercised) peak (?:traffic|demand|load)\\b"
            ]
          },
          "change_condition": {
            "alternatives": [
              {
                "forbidden_patterns": [
                  "\\b(?:fails|misses|exceeds|above|over)\\b"
                ],
                "required_groups": [
                  ["\\b(?:if|when|only when)\\b"],
                  ["\\b(?:noon )?load test\\b"],
                  ["\\b(?:passes|meets (?:its )?(?:p95 )?latency (?:target|threshold)|(?:keeps|reports|shows) (?:p95 )?latency (?:under|below|at most) 200\\s*ms)\\b"],
                  ["\\b(?:move|switch|proceed|deploy)(?:\\s+\\w+){0,3}\\s+(?:full(?: deployment| rollout| release)?|everyone)\\b"]
                ],
                "ordered_groups": [
                  [
                    ["\\b(?:move|switch|proceed|deploy)(?:\\s+\\w+){0,3}\\s+(?:full(?: deployment| rollout| release)?|everyone)\\b"],
                    ["\\b(?:if|when|only when)\\b"],
                    ["\\b(?:noon )?load test\\b"],
                    ["\\b(?:passes|meets (?:its )?(?:p95 )?latency (?:target|threshold)|(?:keeps|reports|shows) (?:p95 )?latency (?:under|below|at most) 200\\s*ms)\\b"]
                  ],
                  [
                    ["\\b(?:if|when|only when)\\b"],
                    ["\\b(?:noon )?load test\\b"],
                    ["\\b(?:passes|meets (?:its )?(?:p95 )?latency (?:target|threshold)|(?:keeps|reports|shows) (?:p95 )?latency (?:under|below|at most) 200\\s*ms)\\b"],
                    ["\\b(?:move|switch|proceed|deploy)(?:\\s+\\w+){0,3}\\s+(?:full(?: deployment| rollout| release)?|everyone)\\b"]
                  ]
                ]
              },
              {
                "forbidden_patterns": [
                  "\\b(?:passes|meets|under|below|at most)\\b"
                ],
                "required_groups": [
                  ["\\b(?:if|when)\\b"],
                  ["\\b(?:noon )?load test\\b"],
                  ["\\b(?:fails|misses|exceeds|(?:p95 )?latency (?:is |stays )?(?:above|over) 200\\s*ms)\\b"],
                  ["\\b(?:keep|hold|remain with|stay with)(?:\\s+\\w+){0,2}\\s+(?:limited|staged) (?:release|rollout|deployment)\\b"]
                ],
                "ordered_groups": [
                  [
                    ["\\b(?:keep|hold|remain with|stay with)(?:\\s+\\w+){0,2}\\s+(?:limited|staged) (?:release|rollout|deployment)\\b"],
                    ["\\b(?:if|when)\\b"],
                    ["\\b(?:noon )?load test\\b"],
                    ["\\b(?:fails|misses|exceeds|(?:p95 )?latency (?:is |stays )?(?:above|over) 200\\s*ms)\\b"]
                  ],
                  [
                    ["\\b(?:if|when)\\b"],
                    ["\\b(?:noon )?load test\\b"],
                    ["\\b(?:fails|misses|exceeds|(?:p95 )?latency (?:is |stays )?(?:above|over) 200\\s*ms)\\b"],
                    ["\\b(?:keep|hold|remain with|stay with)(?:\\s+\\w+){0,2}\\s+(?:limited|staged) (?:release|rollout|deployment)\\b"]
                  ]
                ]
              }
            ]
          }
        },
        "forbidden_patterns": [],
        "no_em_dash": true
      }
    },
    {
      "id": "neutral-record",
      "name": "neutral incident record without invented opinion",
      "prompt": "Record these supplied incident facts for a post-incident timeline: at 09:10 the release lead paused deployment; at 09:14 the security owner confirmed the signing key was unchanged; at 09:18 the support owner opened incident INC-42. Do not recommend remediation or add an opinion.",
      "expected_output": "The record preserves the facts and accountable attribution without manufacturing a recommendation.",
      "files": [],
      "expectations": [
        "The record remains factual.",
        "The record attributes actions to named roles or sources.",
        "The record does not manufacture a recommendation."
      ],
      "covers": ["neutral-record", "concrete-attribution"],
      "deterministic": {
        "required_terms": [
          {"name": "release fact", "term": "release"},
          {"name": "security fact", "term": "security"},
          {"name": "support fact", "term": "support"},
          {"name": "incident identifier", "term": "INC-42"}
        ],
        "forbidden_patterns": [
          "\\bI recommend\\b",
          "^Recommendation:",
          "\\bshould choose\\b"
        ],
        "no_em_dash": true
      }
    },
    {
      "id": "contextual-voice",
      "name": "personal note retains contextual voice",
      "prompt": "Revise my first-person note to remove filler while retaining its candid voice and uneven sentence rhythm. Source note: \"I want us to move fast. I also don't trust the noon numbers yet, and honestly, that bothers me.\"",
      "expected_output": "The revision is direct but still sounds like a candid first-person note rather than a standardized corporate template.",
      "files": [],
      "expectations": [
        "First person remains where it carries the author's voice.",
        "Sentence rhythm is not mechanically regularized.",
        "Active voice, sentence splitting, symmetry, and vocabulary are reviewed in context.",
        "The prose contains no em dash."
      ],
      "covers": ["contextual-voice", "plain-wording", "no-em-dash"],
      "deterministic": {
        "forbidden_patterns": [
          "\\bIt is important to note that\\b",
          "\\bIn order to\\b"
        ],
        "no_em_dash": true
      }
    },
    {
      "id": "protected-content",
      "name": "non-prose and quoted source remain unchanged",
      "prompt": "Explain the supplied artifacts to a person. Preserve each category between its marker lines exactly in your response.\n\nBEGIN PROTECTED CODE\nfunction retryCount(payload) {\n  return payload.retry_count;\n}\nEND PROTECTED CODE\n\nBEGIN PROTECTED SCHEMA\n{\"type\":\"integer\",\"minimum\":1}\nEND PROTECTED SCHEMA\n\nBEGIN PROTECTED DATA\n{\"retry-count\": 3, \"note\": \"keep—exact\"}\nEND PROTECTED DATA\n\nBEGIN PROTECTED QUOTE\n\"Quoted source — preserve this punctuation.\"\nEND PROTECTED QUOTE",
      "expected_output": "The explanation is human-facing prose while protected code, schema, data, and quoted source material remain byte-for-byte unchanged.",
      "files": [],
      "expectations": [
        "The explanation leads with what the reader should know.",
        "Every protected segment remains unchanged.",
        "Human-writing rules do not alter punctuation inside protected content."
      ],
      "covers": [
        "non-prose-fidelity",
        "code-fidelity",
        "schema-fidelity",
        "data-fidelity",
        "quoted-source-fidelity",
        "answer-first",
        "no-em-dash"
      ],
      "deterministic": {
        "answer_first": {
          "topic_patterns": [
            "\\b(?:artifacts?|payload|examples?|inputs?)\\b"
          ],
          "answer_patterns": [
            "\\b(?:use|keep|preserve|unchanged|valid|invalid)\\b"
          ]
        },
        "protected_categories": ["code", "schema", "data", "quote"],
        "forbidden_patterns": [],
        "no_em_dash": true
      }
    }
  ]
}
