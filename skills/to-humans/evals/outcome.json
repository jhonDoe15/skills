{
  "skill_name": "to-humans",
  "version": 1,
  "evaluation": {
    "scope": "to-humans-outcome",
    "layer": "outcome",
    "skill": "to-humans",
    "hosts": ["claude-code", "cursor"],
    "arms": ["no-skill", "treatment"]
  },
  "config": {
    "runs_per_configuration": 3,
    "minimum_treatment_pass_rate": 0.9,
    "minimum_treatment_win_rate": 0.6,
    "randomization_seed": "to-humans-outcome-v1"
  },
  "judge": {
    "score_range": [0, 2],
    "minimum_dimension_score": 1,
    "dimensions": [
      {
        "id": "decision_quality",
        "description": "Includes a recommendation, basis, material uncertainty, and evidence that could change it."
      },
      {
        "id": "reader_effort",
        "description": "Presents the answer before detail and supports scanning without dropping requested content."
      },
      {
        "id": "fidelity",
        "description": "Preserves facts, evidence, uncertainty, requested breadth, and non-prose work products."
      },
      {
        "id": "natural_voice",
        "description": "Removes filler and artificial patterns without standardizing contextual voice."
      }
    ]
  },
  "evals": [
    {
      "id": "complete-human-decision",
      "name": "complete human-facing deployment decision",
      "prompt": "Recommend a deployment approach to the release owner. A staged rollout has verified rollback and a limited first cohort to contain exposure. Peak traffic remains untested. The noon load test passes when p95 latency stays under 200 ms; a passing result supports moving to full deployment, while a miss means keeping the staged rollout. Include the basis, the untested condition that matters, and what result would change the recommendation.",
      "expected_output": "The treatment provides a complete human-facing decision with its canonical dependency, while the matched No-Skill control receives the same scenario without writing Skills.",
      "files": [],
      "expectations": [
        "The recommendation appears before supporting detail.",
        "The basis is concrete.",
        "Material uncertainty remains visible.",
        "The output says what could change the recommendation.",
        "The treatment retains all requested elements and contains no em dash."
      ],
      "covers": [
        "matched-no-skill-control",
        "decision-support",
        "answer-first",
        "requested-breadth",
        "no-em-dash"
      ],
      "deterministic": {
        "answer_first": {
          "topic_patterns": [
            "\\b(?:staged|limited|full) (?:release|rollout|deployment)\\b"
          ],
          "answer_patterns": [
            "\\b(?:recommend|choose|prefer|use|start|proceed|safer|safest|hold|delay)\\b"
          ]
        },
        "decision_support": {
          "recommendation": {
            "required_groups": [
              [
                "\\b(?:limited|staged|full) (?:release|rollout|deployment)\\b"
              ],
              [
                "\\b(?:recommend|choose|prefer|use|start|proceed with)\\b|\\b(?:is|looks|remains) (?:safer|safest|best|preferred|recommended)\\b"
              ]
            ],
            "ordered_groups": [
              [
                [
                  "\\b(?:recommend|choose|prefer|use|start|proceed with)\\b"
                ],
                [
                  "\\b(?:limited|staged|full) (?:release|rollout|deployment)\\b"
                ]
              ],
              [
                [
                  "\\b(?:limited|staged|full) (?:release|rollout|deployment)\\b"
                ],
                [
                  "\\b(?:is|looks|remains) (?:safer|safest|best|preferred|recommended)\\b"
                ]
              ]
            ]
          },
          "basis": {
            "required_groups": [
              [
                "\\b(?:verified rollback|rollback (?:is|was) verified|small first cohort|limited first cohort)\\b"
              ],
              [
                "\\b(?:contain|cap|limit|reduce)\\w* (?:the )?(?:exposure|risk|blast radius)\\b|\\b(?:exposure|risk|blast radius) (?:is |stays )?(?:contained|capped|limited|reduced)\\b"
              ]
            ],
            "ordered_groups": [
              [
                [
                  "\\b(?:verified rollback|rollback (?:is|was) verified|small first cohort|limited first cohort)\\b"
                ],
                [
                  "\\b(?:contain|cap|limit|reduce)\\w* (?:the )?(?:exposure|risk|blast radius)\\b"
                ]
              ],
              [
                [
                  "\\b(?:exposure|risk|blast radius) (?:is |stays )?(?:contained|capped|limited|reduced)(?: by| with| through)\\b"
                ],
                [
                  "\\b(?:verified rollback|rollback (?:is|was) verified|small first cohort|limited first cohort)\\b"
                ]
              ]
            ]
          },
          "material_uncertainty": {
            "required_groups": [
              [
                "\\bpeak (?:traffic|demand|load)\\b"
              ],
              [
                "\\b(?:remains|is) untested\\b|\\b(?:has|have) not (?:yet )?(?:been )?(?:tested|exercised)\\b"
              ]
            ],
            "ordered_groups": [
              [
                [
                  "\\bpeak (?:traffic|demand|load)\\b"
                ],
                [
                  "\\b(?:remains|is) untested\\b|\\b(?:has not|hasn't) (?:yet )?(?:been )?(?:tested|exercised)\\b"
                ]
              ],
              [
                [
                  "\\b(?:have not|haven't) (?:yet )?(?:tested|exercised)\\b"
                ],
                [
                  "\\bpeak (?:traffic|demand|load)\\b"
                ]
              ]
            ]
          },
          "change_condition": {
            "required_groups": [
              [
                "\\b(?:if|when|unless|only when)\\b"
              ],
              [
                "\\b(?:noon )?load test\\b"
              ],
              [
                "\\b(?:(?:p95 )?latency (?:target|threshold)|200\\s*ms|passes|fails|meets|misses|exceeds)\\b"
              ],
              [
                "\\b(?:move|switch|change|reconsider|pause|stop|keep|choose|deploy)\\w*\\b"
              ]
            ],
            "ordered_groups": [
              [
                [
                  "\\b(?:move|switch|change|reconsider|pause|stop|keep|choose|deploy)\\w*\\b"
                ],
                [
                  "\\b(?:if|when|unless|only when)\\b"
                ],
                [
                  "\\b(?:noon )?load test\\b"
                ],
                [
                  "\\b(?:(?:p95 )?latency (?:target|threshold)|200\\s*ms|passes|fails|meets|misses|exceeds)\\b"
                ]
              ],
              [
                [
                  "\\b(?:if|when|unless|only when)\\b"
                ],
                [
                  "\\b(?:noon )?load test\\b"
                ],
                [
                  "\\b(?:(?:p95 )?latency (?:target|threshold)|200\\s*ms|passes|fails|meets|misses|exceeds)\\b"
                ],
                [
                  "\\b(?:move|switch|change|reconsider|pause|stop|keep|choose|deploy)\\w*\\b"
                ]
              ]
            ]
          }
        },
        "forbidden_patterns": [],
        "no_em_dash": true
      }
    }
  ]
}
