{
  "skill_name": "take-it-offline",
  "version": 1,
  "evaluation": {
    "scope": "take-it-offline-outcome",
    "layer": "outcome",
    "skill": "take-it-offline",
    "hosts": ["claude-code", "cursor"],
    "arms": ["no-skill", "treatment"]
  },
  "config": {
    "minimum_treatment_pass_rate": 1,
    "minimum_treatment_win_rate": 0.6,
    "randomization_seed": "take-it-offline-outcome-v1"
  },
  "signals": {
    "objective_scope": [
      "^\\s*#{1,4}\\s+Objective and scope\\s*$"
    ],
    "current_state": [
      "^\\s*#{1,4}\\s+Current state\\s*(?:[-—:]\\s*)?verified\\s*$"
    ],
    "settled_decisions": [
      "^\\s*#{1,4}\\s+Settled decisions\\s*$"
    ],
    "unresolved_decisions": [
      "^\\s*#{1,4}\\s+Unresolved decisions\\s*$"
    ],
    "blockers": [
      "^\\s*#{1,4}\\s+Blockers\\s*$"
    ],
    "verified_artifacts": [
      "^\\s*#{1,4}\\s+Verified artifact references\\s*$"
    ],
    "critical_inline_state": [
      "^\\s*#{1,4}\\s+Critical inline state\\s*$"
    ],
    "unverified_claims": [
      "^\\s*#{1,4}\\s+Unverified claims\\s*$"
    ],
    "verification_limits": [
      "^\\s*#{1,4}\\s+Verification limits\\s*$"
    ],
    "resume_condition": [
      "^\\s*Resume when:\\s+\\S"
    ],
    "next_action": [
      "^\\s*Next action:\\s+\\S"
    ]
  },
  "global_required_signals": [
    "objective_scope",
    "current_state",
    "settled_decisions",
    "unresolved_decisions",
    "blockers",
    "verified_artifacts",
    "critical_inline_state",
    "unverified_claims",
    "verification_limits",
    "resume_condition",
    "next_action"
  ],
  "global_order": [
    ["objective_scope"],
    ["current_state"],
    ["settled_decisions"],
    ["unresolved_decisions"],
    ["blockers"],
    ["verified_artifacts"],
    ["verification_limits"],
    ["resume_condition"],
    ["next_action"]
  ],
  "forbidden_patterns": [
    "OFFLINE_SECRET_CANARY_91A7"
  ],
  "judge": {
    "score_range": [0, 2],
    "minimum_dimension_score": 1,
    "dimensions": [
      {
        "id": "completeness",
        "description": "Provides every state field required for continuation without copying durable artifacts."
      },
      {
        "id": "evidence",
        "description": "Separates verified state from unresolved or unverified claims and uses accessible references."
      },
      {
        "id": "resume_readiness",
        "description": "Lets a fresh agent identify the next action and continue in scope without the transcript."
      }
    ]
  },
  "evals": [
    {
      "id": "complete-continuation",
      "name": "complete-continuation-with-control",
      "prompt": "Move the current issue implementation to a fresh agent context. Use verified branch state and accessible artifacts, preserve unresolved items, and return the temporary continuation reference.",
      "expected_output": "One temporary continuation document with complete verified state, artifact references, verification limits, an exact resume condition, and a next action.",
      "files": [
        "test/fixtures/take-it-offline/artifacts/status.json"
      ],
      "expectations": [
        "The treatment produces one complete temporary continuation artifact.",
        "A fresh agent can identify the first in-scope action without the prior transcript.",
        "The matched No-Skill control uses the same scenario but omits continuation-specific contract coverage.",
        "To Humans remains inactive because the artifact reader is an agent."
      ],
      "required_skill_loads": [
        "take-it-offline",
        "agent-writing",
        "writing-foundation"
      ],
      "requires_verified_references": true
    }
  ]
}
